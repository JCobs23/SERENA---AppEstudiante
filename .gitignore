# Unity .gitignore - place at project root
# Based on GitHub Unity.gitignore (cleaned and simplified)

# OS files
.DS_Store
Thumbs.db

# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
UserSettings/
MemoryCaptures/
Recordings/
CrashReports/

# Asset store tools (uncomment if used)
# /Assets/AssetStoreTools*

# Rider, Visual Studio, VSCode
.vs/
.idea/
.vscode/
*.sln
*.dll
*.csproj
*.unityproj
*.suo
*.tmp
*.user
*.slnx
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Gradle
.gradle/

# Exported objects
ExportedObj/
.consulo/

# Crash reports and sysinfo
sysinfo.txt

# Build outputs and packages
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta

# Packed Addressables and large binary caches
/Assets/AddressableAssetsData/*/*.bin*
/Assets/StreamingAssets/aa.meta
/Assets/StreamingAssets/aa/

# Ignore generated meta files for pdb/pidb/mdb
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Logs
*.log

# Git LFS placeholder (if you use LFS, track large asset types in .gitattributes)
# Example: *.psd filter=lfs diff=lfs merge=lfs -text
